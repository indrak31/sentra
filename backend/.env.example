# ==============================================================================
# SENTRA Backend Configuration Template
# ==============================================================================

# Environment: "development" | "production" | "staging"
ENVIRONMENT=development
PROJECT_NAME="SENTRA — State-wise Environmental, Natural-disaster, Health-impact and Resource Optimization Platform"
API_V1_STR=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Database Settings
# ------------------------------------------------------------------------------
# PostgreSQL (Production / Railway default):
DATABASE_URL=postgresql+psycopg://sentra_user:sentra_password@localhost:5432/sentra_db

# Note: If PostgreSQL is unreachable or not configured, SENTRA automatically
# falls back to a local SQLite database (sqlite:///sentra.db) with auto-seeding.

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=sentra_production_jwt_secret_key_32bytes_minimum_2026_ndma
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sentra-backend
JWT_AUDIENCE=sentra-platform

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" for open access or specify your frontend URLs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,*

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
OPTIMIZATION_RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# Initial Bootstrap Superuser Credentials
# ------------------------------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@sentra.gov.in
FIRST_SUPERUSER_PASSWORD=AdminSecurePassword123!
FIRST_SUPERUSER_NAME="National Disaster Administrator"

# ------------------------------------------------------------------------------
# Optional: External AI Model / Google Colab Bridge
# ------------------------------------------------------------------------------
# COLAB_API_URL=https://<your-ngrok-or-colab-tunnel>.ngrok-free.app

